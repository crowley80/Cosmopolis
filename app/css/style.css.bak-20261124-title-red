/* Atlas de Athun: estados de exploración sin revelar territorio desconocido. */
.atlas-legend {
  display:flex;
  flex-wrap:wrap;
  gap:8px 14px;
  margin:10px 0 16px;
  padding:9px 10px;
  color:#674728;
  background:rgba(116,75,34,.08);
  border:1px solid rgba(105,68,31,.3);
  font-size:.82rem;
}
.atlas-legend span { display:inline-flex; align-items:center; gap:5px; }
.atlas-dot,.atlas-marker {
  display:inline-block;
  width:10px;
  height:10px;
  flex:0 0 10px;
  border:1px solid #69431e;
  border-radius:50%;
}
.atlas-dot-visible,.atlas-place-current .atlas-marker,.atlas-place-visible .atlas-marker {
