@import url('https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=UnifrakturMaguntia&display=swap');
* {
    box-sizing: border-box;
}

:root {
    color-scheme: light;
    --paper: #ead9b5;
    --paper-light: #f7edda;
    --paper-mid: #e5d0a6;
    --paper-dark: #c9ad78;
    --ink: #392719;
    --ink-soft: #65472d;
    --muted: #806747;
    --leather: #654329;
    --leather-dark: #3e2818;
    --gold: #a9823f;
    --gold-light: #d4b875;
    --rule: rgba(104, 72, 37, .42);
    --shadow: rgba(25, 15, 7, .48);
    --field: #fbf3e2;
}

html {
    min-height: 100%;
    background: #302116;
}

body {
    min-height: 100vh;
    margin: 0;
    padding: 22px 14px;
    color: var(--ink);
    background:
        radial-gradient(ellipse at 50% 8%, rgba(181, 139, 79, .2), transparent 48%),
        repeating-linear-gradient(25deg, rgba(255, 231, 181, .018) 0 1px, transparent 1px 5px),
        linear-gradient(135deg, #493421, #21170f 78%);
    font-family: Georgia, 'Palatino Linotype', 'Book Antiqua', serif;
    line-height: 1.65;
}

#app {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
}

.main-header {
    padding: 34px 15px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(205, 174, 116, .4);
}

.main-header h1 {
    margin: 7px 0;
    color: var(--paper-light);
    font-size: clamp(2.5rem, 10vw, 4rem);
    letter-spacing: .09em;
    text-shadow: 0 2px 2px #170e08, 0 0 18px rgba(213, 177, 111, .22);
}

.main-header p {
    margin: 5px 0;
    color: #d0b98f;
}

.eyebrow {
    color: #98713b;
    font-family: Georgia, serif;
    font-size: .69rem;
    font-weight: bold;
    letter-spacing: .19em;
    text-transform: uppercase;
}

.welcome {
    padding: 25px 10px;
    text-align: center;
    color: #ead9b5;
}

.welcome h2 {
    margin-bottom: 8px;
    color: #f0dfbd;
    font-size: 1.6rem;
}

.welcome p {
    margin: 0;
    color: #d0b98f;
}

.character-creation {
    position: relative;
    margin: 15px auto 35px;
    padding: 25px 22px;
    background:
        radial-gradient(ellipse at 18% 7%, rgba(255, 255, 236, .72), transparent 38%),
        radial-gradient(ellipse at 90% 90%, rgba(139, 92, 42, .13), transparent 42%),
        repeating-linear-gradient(3deg, rgba(101, 70, 36, .025) 0 1px, transparent 1px 4px),
        linear-gradient(135deg, #f1e3c4, #dfc99d 55%, #eddbb7);
    border: 1px solid #a47c45;
    outline: 1px solid rgba(224, 190, 124, .38);
    outline-offset: 4px;
    box-shadow: 0 16px 38px var(--shadow), inset 0 0 35px rgba(117, 75, 31, .12);
}

.character-creation::before,
.character-creation::after {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 9px;
    content: "❧     ✦     ❧";
    color: rgba(133, 94, 45, .66);
    text-align: center;
    font-size: 12px;
    line-height: 9px;
    pointer-events: none;
}

.character-creation::before { top: 7px; }
.character-creation::after { bottom: 7px; }

.section-heading {
    margin: 10px 0 28px;
    text-align: center;
}

.section-heading h2 {
    margin: 8px 0;
    color: var(--leather-dark);
    font-size: 1.8rem;
}

.section-heading p {
    color: var(--ink-soft);
    font-size: .95rem;
}

fieldset {
    min-width: 0;
    margin: 0 0 22px;
    padding: 17px;
    background: rgba(255, 248, 230, .35);
    border: 1px solid var(--rule);
    border-radius: 2px;
    box-shadow: inset 0 0 18px rgba(112, 75, 34, .045);
}

legend {
    padding: 3px 10px;
    color: var(--leather-dark);
    font-size: 1.02rem;
    font-weight: bold;
}

label {
    display: block;
    margin: 12px 0 7px;
    color: var(--ink-soft);
    font-size: .95rem;
}

input,
textarea {
    display: block;
    width: 100%;
    padding: 13px;
    color: var(--ink);
    background:
        repeating-linear-gradient(0deg, rgba(111, 78, 39, .025) 0 1px, transparent 1px 5px),
        var(--field);
    border: 1px solid #b69a6b;
    border-radius: 2px;
    font-family: Georgia, serif;
    font-size: 16px;
    line-height: 1.5;
    outline: none;
}

textarea {
    min-height: 105px;
    resize: vertical;
}

input:focus,
textarea:focus {
    border-color: var(--gold);
    box-shadow: 0 0 0 2px rgba(167, 125, 53, .18);
}

input::placeholder,
textarea::placeholder {
    color: #927d60;
}

button {
    display: block;
    width: 100%;
    margin-top: 24px;
    padding: 15px;
    color: #f8edda;
    background:
        linear-gradient(180deg, rgba(255, 226, 167, .13), transparent 48%),
        linear-gradient(135deg, #805a35, #4b301c);
    border: 1px solid #b28d4d;
    border-radius: 3px;
    box-shadow: inset 0 1px rgba(255, 239, 198, .2), inset 0 -2px rgba(28, 16, 8, .2), 0 4px 9px rgba(69, 43, 19, .2);
    font-family: Georgia, serif;
    font-size: 1rem;
    font-weight: bold;
    letter-spacing: .025em;
    cursor: pointer;
}

button:active { transform: translateY(1px); }
button:focus-visible { outline: 3px solid rgba(167, 125, 53, .5); outline-offset: 2px; }

#message {
    margin-top: 18px;
    color: var(--leather-dark);
    text-align: center;
}

footer {
    padding: 20px;
    color: #d9c49c;
    border-top: 1px solid rgba(224, 194, 139, .35);
    text-align: center;
    font-size: .85rem;
}



/* AVENTURA — composición fiel a la referencia original de Cosmopolis.
   Se conserva la tipografía Unifraktur Maguntia + IM Fell English. */

:root {
  --manuscript-ink: #321805;
  --manuscript-line: #60300d;
}

body {
  margin: 0;
  padding: 0;
  background: #050302;
  font-family: 'IM Fell English', Georgia, serif;
}

.adventure-screen {
  position: fixed;
  inset: 0 auto 0 50%;
  z-index: 10;
  display: flex;
  width: min(100%, 760px);
  height: 100vh;
  height: 100dvh;
  padding: 3px 5px max(5px, env(safe-area-inset-bottom));
  flex-direction: column;
  gap: 0;
  overflow: hidden;
  isolation: isolate;
  color: var(--manuscript-ink);
  transform: translateX(-50%);
  background: transparent;
}

