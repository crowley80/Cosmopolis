    radial-gradient(ellipse at 73% 17%, rgba(110,55,13,.23) 0 2%, transparent 19%),
    radial-gradient(ellipse at 36% 73%, rgba(122,58,14,.25) 0 2%, transparent 20%),
    radial-gradient(ellipse at 84% 68%, rgba(98,45,12,.26) 0 1.5%, transparent 18%),
    radial-gradient(ellipse at 21% 37%, rgba(94,43,10,.2) 0 1.5%, transparent 22%),
    radial-gradient(ellipse at 78% 57%, rgba(111,53,12,.18) 0 2%, transparent 24%),
    radial-gradient(ellipse at 42% 84%, rgba(255,222,164,.20) 0 6%, transparent 22%),
