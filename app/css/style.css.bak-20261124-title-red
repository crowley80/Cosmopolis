.atlas-dot-visited,.atlas-place-visited .atlas-marker {
  background:#b27a39;
  border-color:#75491d;
}
.atlas-dot-known,.atlas-place-known .atlas-marker {
  background:#d9c49c;
  border-color:#80633c;
